          "question": {
            "text": "An X-ray tube is operated at $15 \\mathrm{kV}$. Calculate the upper limit of the speed of the electrons striking the target.",
            "image": null
          },
          "options": [
            {
              "id": "ZWhS6",
              "text": "$7.26 \\times 10^{7} \\mathrm{~m} / \\mathrm{s}$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "XHgq9",
              "text": "$7.62 \\times 10^{7} \\mathrm{~m} / \\mathrm{s}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "G7GLm",
              "text": "$7.62 \\times 10^{7} \\mathrm{~cm} / \\mathrm{s}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "826HL",
              "text": "$7.26 \\times 10^{9} \\mathrm{~m} / \\mathrm{s}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "The maximum kinetic energy of an electron accelerated through a potential difference of $\\mathrm{V}$ volt is $\\frac{1}{2} \\mathrm{mv}^{2}=\\mathrm{eV}$\n$$\n\\begin{array}{l}\n\\therefore \\text { maximum velocity } \\mathrm{v}=\\sqrt{\\frac{2 \\mathrm{eV}}{\\mathrm{m}}} \\\\\n\\mathrm{v}=\\sqrt{\\frac{2 \\times 1.6 \\times 10^{-19} \\times 15000}{9.1 \\times 10^{-31}}} \\\\\n\\mathrm{v}=7.26 \\times 10^{7} \\mathrm{~m} / \\mathrm{s}\n\\end{array}\n$$",
            "image": null
          },
