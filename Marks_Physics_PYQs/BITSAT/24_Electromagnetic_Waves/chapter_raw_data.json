          "question": {
            "text": "Electromagnetic waves travel in a medium with speed of $1.5 \\times 10^8 \\mathrm{~ms}^{-1}$. The relative permeability of the medium is 2.0 . The relative permittivity will be :",
            "image": null
          },
          "options": [
            {
              "id": "RAQJg",
              "text": "$5$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "F3615",
              "text": "$1$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "4Hxu3",
              "text": "$4$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "tqa1I",
              "text": "$2$",
              "image": null,
              "isCorrect": true
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$v=\\frac{C}{\\sqrt{\\mu_{\\mathrm{r}} \\epsilon_{\\mathrm{r}}}}$\n$\\Rightarrow 1.5 \\times 10^8=\\frac{3 \\times 10^8}{\\sqrt{2 \\times \\epsilon_{\\mathrm{r}}}}$\n$\\Rightarrow 2 \\epsilon_{\\mathrm{T}}=4 \\Rightarrow \\epsilon_{\\mathrm{T}}=2$",
            "image": null
          },
          "videoSolution": null,
