              "image": null,
              "isCorrect": true
            },
            {
              "id": "lYn3r",
              "text": "1",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "qmdWa",
              "text": "3",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "We have $\\frac{\\mathrm{U}_{\\mathrm{E}}}{\\mathrm{U}_{\\mathrm{T}}}=\\frac{\\mathrm{U}_{\\mathrm{E}}}{\\mathrm{U}_{\\mathrm{E}}+\\mathrm{U}_{\\mathrm{B}}}=\\frac{\\mathrm{U}_{\\mathrm{E}}}{2 \\mathrm{U}_{\\mathrm{E}}}=\\frac{1}{2}$<br />$\\left[\\because \\mathrm{U}_{\\mathrm{E}}=\\mathrm{U}_{\\mathrm{B}}=\\frac{1}{2} \\in_0 \\mathrm{E}_0^2=\\frac{\\mathrm{B}_0^2}{2 \\mu_0}\\right]$",
            "image": null
