          ],
          "question": {
            "text": "$C_V$ and $C_p$ denote the molar specific heat capacities of a gas at constant volume and constant pressure, respectively. Then",
            "image": null
          },
          "options": [
            {
              "id": "RQbGT",
              "text": "\n$C_p-C_V$ is larger for a diatomic ideal gas than for a monoatomic ideal gas\n",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "ruZOl",
              "text": "\n$C_p+C_V$ is larger for a diatomic ideal gas than for a monoatomic ideal gas.\n",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "Z0fby",
              "text": "\n$\\frac{C_p}{C_V}$ is larger for a diatomic ideal gas than for a monoatomic ideal gas\n",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "JeNgv",
              "text": "\n$C_p \\cdot C_V$ is larger for a diatomic ideal gas than for a monoatomic ideal gas",
              "image": null,
              "isCorrect": true
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "For monoatomic gas,\n$$\nC_p=\\frac{5}{2} R \\text { and } C_V=\\frac{3}{2} R\n$$\n\nFor diatomic gas,\n$$\nC_p=\\frac{7}{2} R \\text { and } C_V=\\frac{5}{2} R\n$$",
            "image": null
          },
          "videoSolution": null,
