            {
              "id": "qqCAA",
              "text": "The average energy per mole of the gas mixture is  <math><mn>2</mn><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">T</mi></math>",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "yE0zk",
