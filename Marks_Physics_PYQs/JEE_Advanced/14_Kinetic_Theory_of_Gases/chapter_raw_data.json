              "text": "1 : 2",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "Ka562",
              "text": "6 : 9",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "0Su7L",
              "text": "8 : 9",
              "isCorrect": true,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<p>Given,&nbsp;<math> <mrow> <mfrac> <mrow> <msub> <mtext>m</mtext> <mtext>A</mtext> </msub> </mrow> <mrow> <msub> <mtext>m</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>2</mn> </mrow> <mrow> <mn>3 &#8203;</mn></mrow></mfrac></mrow></math><br /><math> <mrow> <mo>&#8757;&#160;&#160;&#160;</mo> </mrow> </math> Volume and temperature is same.<br />From ideal gas equation,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>V</mi><mo>=</mo><mi>n</mi><mi>R</mi><mi>T</mi></math><br /><math> <mrow> <mfrac> <mrow> <mtext>P</mtext> </mrow> <mrow> <mtext>n</mtext> </mrow> </mfrac> <mo>&#160;=&#160;</mo> <mo>constant</mo> </mrow> </math><br /><math> <mrow> <mfrac> <mrow> <msub> <mtext>P</mtext> <mtext>A</mtext> </msub> </mrow> <mrow> <msub> <mtext>n</mtext> <mtext>A</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <msub> <mtext>P</mtext> <mtext>B</mtext> </msub> </mrow> <mrow> <msub> <mtext>n</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> <mo>&#8658;</mo> <mfrac> <mrow> <mrow> <msub> <mtext>n</mtext> <mtext>A</mtext> </msub> </mrow> </mrow> <mrow> <msub> <mtext>n</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <msub> <mtext>P</mtext> <mtext>A</mtext> </msub> </mrow> <mrow> <msub> <mtext>P</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>4</mn> </mrow> <mrow> <mn>3</mn> </mrow> </mfrac> </mrow> </math></p><p>Also, density,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#961;</mi><mo>=</mo><mfrac><mi>M</mi><mi>V</mi></mfrac></math><br /><math> <mrow> <mfrac> <mrow> <msub> <mtext>&#961;</mtext> <mtext>A</mtext> </msub> </mrow> <mrow> <msub> <mtext>&#961;</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <msub> <mtext>M</mtext> <mtext>A</mtext> </msub> <mo>/</mo> <mtext mathvariant=\"italic\">v</mtext> </mrow> <mrow> <msub> <mtext>M</mtext> <mtext>B</mtext> </msub> <mo>/</mo> <mtext mathvariant=\"italic\">v</mtext> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <msub> <mtext>n</mtext> <mtext>A</mtext> </msub> <msub> <mo>m</mo> <mtext>A</mtext> </msub> </mrow> <mrow> <msub> <mtext>n</mtext> <mtext>B</mtext> </msub> <msub> <mtext>m</mtext> <mtext>B</mtext> </msub> </mrow> </mfrac> </mrow> </math><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mo>=</mo> <mfrac> <mrow> <mn>4</mn> </mrow> <mrow> <mn>3</mn> </mrow> </mfrac> <mo>&#215;</mo> <mfrac> <mrow> <mn>2</mn> </mrow> <mrow> <mn>3</mn> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>8</mn> </mrow> <mrow> <mn>9</mn> </mrow> </mfrac> </mrow> </math>.</p>",
