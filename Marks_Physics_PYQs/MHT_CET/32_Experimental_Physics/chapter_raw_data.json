            }
          ],
          "question": {
            "text": "In balanced meter bridge, the resistance of bridge wire is <math><mn>0.1</mn><mi>&nbsp;</mi><mrow><mrow><mi mathvariant=\"normal\">Ω&nbsp;</mi></mrow><mo>cm.</mo></mrow></math>&nbsp;Unknown resistance <math><msup><mrow><mi>X</mi></mrow></msup></math>&nbsp;is connected in left gap and <math><mn>6&nbsp;</mn><mi mathvariant=\"normal\">Ω</mi></math> in right gap, null point divides the wire in the ratio <math><mn>2</mn><mo>:</mo><mn>3</mn></math>. Find the current drawn from the battery of <math><mi> 5 V</mi></math> having negligible resistance.",
            "image": null
          },
          "options": [
            {
              "id": "cOuWd",
              "text": "<math><mn>1</mn><mi>&nbsp;</mi><mn>A</mn></math>",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "OTTry",
              "text": "<math><mn>1.5</mn><mi> </mi><mn>A</mn></math>",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "4wE1p",
              "text": "<math><mn>2</mn><mi> </mi><mn>A</mn></math>",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "Gtgr6",
              "text": "<math><mn>5</mn><mi> </mi><mn>A</mn></math>",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<math><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><br />Now <math><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>v</mi><mo>=</mo><mn>5</mn><mi>&nbsp;</mi><mn>V</mn></math> <math><mo>=</mo><mi>I</mi><mi>R</mi></math><br />For potentiometer wire <math><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mfrac><mrow><mi>x</mi></mrow><mrow><mn>6</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>⇒</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mi mathvariant=\"script\">l</mi></mrow></mfrac><mo>=</mo><mn>4</mn><mi>&nbsp;</mi><mfrac><mrow><mi mathvariant=\"normal\">Ω</mi></mrow><mrow><mi mathvariant=\"normal\">m</mi></mrow></mfrac></math><br />The resistance of wire is <math><mfrac><mrow><mn>0.1</mn><mi mathvariant=\"normal\">Ω</mi></mrow><mrow><mn>c</mn><mn>m</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mi mathvariant=\"normal\">Ω</mi></mrow><mrow><mn>m</mn></mrow></mfrac></math><br /><math><mo>∴</mo><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><msub><mrow><mi>R</mi></mrow><mrow><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">f</mi></mrow></msub><mo>=</mo><mn>5</mn></math><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>i</mi><mo>=</mo><mfrac><mrow><mi>V</mi></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">f</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>=</mo><mn>1</mn><mi>&nbsp;</mi><mn>A</mn></math>",
