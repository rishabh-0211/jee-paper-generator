              "isCorrect": false
            },
            {
              "id": "seYEi",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn></math>",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "HDAdn",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn></math>",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "BBtQZ",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>48</mn></math>",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>l</mi><mi>x</mi></msub><mo>=</mo><mn>40</mn><mi>&#160;</mi><mi>cm</mi><mo>,</mo><mi>&#160;</mi><msub><mi>l</mi><mi>R</mi></msub><mo>=</mo><mn>60</mn><mi mathvariant=\"normal\">&#160;</mi><mi>cm</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>x</mi><mi>R</mi></mfrac><mo>=</mo><mfrac><msub><mi>l</mi><mi>x</mi></msub><msub><mi>l</mi><mi>R</mi></msub></mfrac><mo>=</mo><mfrac><mn>40</mn><mn>60</mn></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></math> ....... (i)<br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><mi>x</mi><mo>+</mo><mn>30</mn><mi>&#160;</mi></mrow><mrow><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>60</mn></mrow><mrow><mn>40</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><mi>x</mi><mo>+</mo><mn>30</mn></mrow><mrow><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mn>2x</mn><mfenced separators=\"|\"><mrow><mo>+</mo><mn>30</mn></mrow></mfenced><mi></mi><mi></mi><mi></mi><mo>=</mo><mi></mi><mi></mi><mi></mi><mn>3</mn><mi>R</mi></math><br /><math><mi>R</mi><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mn>2</mn><mo>(</mo><mi>x</mi><mo>+</mo><mn>30</mn><mo>)</mo></mrow><mrow><mn>3</mn></mrow></mfrac></math> ........ (ii)<br />From (i) and (ii),<br /><math><mfrac><mrow><mn>3</mn><mi>x</mi></mrow><mrow><mn>2</mn><mo>(</mo><mi>x</mi><mo>+</mo><mn>30</mn><mo>)</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mn>9</mn><mi>x</mi><mo>=</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>120</mn></math><br /><math><mn>5</mn><mi>x</mi><mo>=</mo><mn>120</mn><mi>&#160;</mi><mi>&#160;</mi><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mn>24</mn><mi>&#160;</mi><mi mathvariant=\"normal\">&#937;</mi></math>",
