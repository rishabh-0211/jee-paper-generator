              "isCorrect": true
            },
            {
              "id": "dMt4y",
              "text": "$l / 2 \\mathrm{~cm}$ from left end.",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "z403M",
              "text": "$l / 4 \\mathrm{~cm}$ from left end.",
              "image": null,
              "isCorrect": false
