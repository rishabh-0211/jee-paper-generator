        {
          "_id": "65a25eaf0279619d9d8a1671",
          "type": "singleCorrect",
          "level": 2,
          "questionLabels": [],
          "previousYearPapers": [
            {
              "_id": "61c078cd071b5bb33b3f9f61",
              "examId": "615d7745c52ffa3c944600e5",
