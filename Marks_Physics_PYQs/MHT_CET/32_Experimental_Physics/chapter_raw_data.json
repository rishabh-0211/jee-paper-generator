              "text": "$(100-l)$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "pzIgm",
              "text": "$(100-2 l)$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "W88pa",
              "text": "$(100-3 l)$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "IEOSL",
              "text": "$\\left(100-\\frac{l}{2}\\right)$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\begin{aligned}\n& \\text { For a Metre bridge, } \\\\\n& \\frac{\\mathrm{X}}{\\mathrm{R}}=\\frac{l_{\\mathrm{X}}}{l_{\\mathrm{R}}}\n\\end{aligned}$\nAfter doubling and interchanging the left and right gap resistances, the ratio of the resistances do not change.\nThis means the null point does not change.\n$\\therefore \\quad$ The new position will remain at $(100-l)$.",
            "image": null
          },
