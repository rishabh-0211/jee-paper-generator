          "question": {
            "text": "A glass convex lens is of refractive index $1 \\cdot 55$ with both faces of same radius of curvature. What will be the radius of curvature if focal length is to be $20 \\mathrm{~cm}$ ?",
            "image": null
          },
          "options": [
            {
              "id": "j9x82",
              "text": "$22 \\mathrm{~cm}$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "qNFlW",
              "text": "$21 \\mathrm{~cm}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "eUbLr",
              "text": "$18 \\mathrm{~cm}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "FZZy7",
              "text": "$20 \\mathrm{~cm}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Lens maker's formula,\n\\(\\frac{1}{\\mathrm{f}}=(\\mu-1)\\left(\\frac{1}{\\mathrm{R}_{1}}-\\frac{1}{\\mathrm{R}_{2}}\\right)\\)\nHere, \\(\\mathrm{f}=20 \\mathrm{~cm}, \\mu=1.55, \\mathrm{R}_{1}=\\mathrm{R}, \\mathrm{R}_{2}=-\\mathrm{R}\\)\n\\(\\begin{aligned}\n&\\frac{1}{20}=(1.55-1)\\left(\\frac{1}{R}-\\frac{1}{(-R)}\\right) \\text { or } \\frac{1}{20}=0.55 \\times \\frac{2}{R} \\\\\n&\\Rightarrow R=1.1 \\times 20=22 \\mathrm{~cm}\n\\end{aligned}\\)",
            "image": null
          },
