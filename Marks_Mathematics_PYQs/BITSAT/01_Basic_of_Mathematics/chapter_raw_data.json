          "question": {
            "text": "The set of all real $x$ satisfying the inequality\r\n\r\n$\\frac{3-|x|}{4-|x|} \\geq 0,$ is",
            "image": null
          },
          "options": [
            {
              "id": "Oiv9f",
              "text": "[-3,3]$\\cup(-\\infty,-4) \\cup(4, \\infty)$",
              "isCorrect": true,
              "image": null
            },
            {
