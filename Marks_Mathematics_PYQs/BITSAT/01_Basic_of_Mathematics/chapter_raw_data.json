          "question": {
            "text": "If $x, y$ and $z$ are real numbers, the $x^{2}+4 y^{2}+9 z^{2}-6 y z-3 z x-2 x y$ is always",
            "image": null
          },
          "options": [
            {
              "id": "ESRNK",
              "text": "positive",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "w8y6P",
              "text": "non-positive",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "dL5Gj",
              "text": "zero",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "I9tpf",
              "text": "non-negative",
              "isCorrect": true,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$x^{2}+4 y^{2}+9 z^{2}-6 y z-3 z x-2 x y$\r\n\r\n$=x^{2}+(2 y)^{2}+(3 z)^{2}-(2 y)(3 z)-(3 z)(x)-$ $x(2 y) \\geq 0 \\forall x, y, z$\r\n\r\n$\\left[\\because \\mathrm{a}^{2}+\\mathrm{b}^{2}+\\mathrm{c}^{2}-\\mathrm{ab}-\\mathrm{bc}-\\mathrm{ca} \\geq 0\\right]$",
            "image": null
          },
          "videoSolution": null,
