              "image": null,
              "isCorrect": true
            },
            {
              "id": "09lfJ",
              "text": "\\(12 / \\sqrt{3}\\)",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "FFrPg",
              "text": "None of these",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Length of ladder \\(=\\frac{6 \\sqrt{3}}{\\sin 60^{\\circ}}=12 \\mathrm{~m}\\)",
