          ],
          "question": {
            "text": "In a triangle \\(\\mathrm{ABC}, \\angle \\mathrm{C}=90^{\\circ}\\), then \\(\\frac{a^2-b^2}{a^2+b^2}\\) is equal to :",
            "image": null
          },
          "options": [
            {
              "id": "hr5z9",
              "text": "\\(\\sin (\\mathrm{A}+\\mathrm{B})\\)",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "OsfPb",
              "text": "\\(\\sin (A-B)\\)",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "mbTPP",
              "text": "\\(\\cos (\\mathrm{A}+\\mathrm{B})\\)",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "PrTK9",
              "text": "\\(\\sin \\left(\\frac{\\mathrm{A}-\\mathrm{B}}{2}\\right)\\)",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "\\(\\begin{aligned}\n& \\mathrm{A}+\\mathrm{B}=180^{\\circ}-\\mathrm{C}=90^{\\circ} \\\\\n& \\mathrm{a}=2 \\mathrm{R} \\sin \\mathrm{A}, b=2 \\mathrm{R} \\sin \\mathrm{B}, c=2 \\mathrm{R} \\sin \\mathrm{C} \\\\\n& \\begin{array}{l}\n\\therefore \\frac{a^2-b^2}{a^2+b^2}=\\frac{\\sin ^2 \\mathrm{~A}-\\sin ^2 \\mathrm{~B}}{\\sin ^2 \\mathrm{~A}+\\sin ^2 \\mathrm{~B}} \\\\\n\\quad=\\frac{\\sin (\\mathrm{A}+\\mathrm{B}) \\sin (\\mathrm{A}-\\mathrm{B})}{\\sin ^2 \\mathrm{~A}+\\sin ^2\\left(90^{\\circ}-\\mathrm{A}\\right)} \\\\\n{\\left[\\because \\mathrm{A}+\\mathrm{B}=90^{\\circ}\\right]} \\\\\n=\\frac{\\sin 90^{\\circ} \\sin (\\mathrm{A}-\\mathrm{B})}{\\sin ^2 \\mathrm{~A}+\\cos ^2 \\mathrm{~A}}=\\sin (\\mathrm{A}-\\mathrm{B})\n\\end{array}\n\\end{aligned}\\)",
            "image": null
          },
