              "text": "If $S_2$ is false, then $S_1$ is false",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "v9Voq",
              "text": "If $S_2$ is false, then $S_1$ is true",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "zOOqx",
              "text": "If $S_1$ is false, then $S_2$ is false",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Given statement $S_1:(\\sim p \\vee q) \\vee(\\sim p \\vee r)$\n$\\equiv \\sim p \\vee(q \\vee r)$\n$S_2: p \\rightarrow(q \\vee r)$\n$\\equiv \\sim p \\vee(q \\vee r) \\rightarrow$ By conditional law\n$S_1 \\equiv S_2$",
            "image": null
          },
