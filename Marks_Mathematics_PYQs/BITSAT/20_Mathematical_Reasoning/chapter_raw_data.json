          "question": {
            "text": "Negation of \"Paris in France and London is in England\" is",
            "image": null
          },
          "options": [
            {
              "id": "oRn94",
              "text": "Paris is in England and London is in France",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "ZBfRf",
              "text": "Paris is not in France or London is not in England",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "ffkkM",
              "text": "Paris is in England or London is in France",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "wnChf",
              "text": "None of these",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Let \\(p\\) : Paris is in France, \\(q\\) : London is in England\n\\(\\therefore \\quad\\) we have \\(p \\wedge q\\)\nIts negation is \\(\\sim(p \\wedge q)=\\sim p \\vee \\sim q\\)\ni.e., Paris is not in France or London is not in England.",
            "image": null
          },
