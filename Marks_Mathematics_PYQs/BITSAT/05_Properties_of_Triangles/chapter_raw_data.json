          ],
          "question": {
            "text": "In an equilateral triangle, the in radius, circumradius and one of the ex-radii are in the ratio",
            "image": null
          },
          "options": [
            {
              "id": "zLIaP",
              "text": "\\(2: 3: 5\\)",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "Ytq1Y",
              "text": "\\(1: 2: 3\\)",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "V9tbt",
              "text": "\\(3: 7: 9\\)",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "YP1Hv",
              "text": "\\(3: 7: 9\\)",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "We have \\(\\Delta=\\frac{\\sqrt{3}}{4} \\mathrm{a}^2, \\mathrm{~s}=\\frac{3 \\mathrm{a}}{2}\\)\n\\(\\therefore \\quad r=\\frac{\\Delta}{\\mathrm{s}}=\\frac{\\mathrm{a}}{2 \\sqrt{3}}, \\mathrm{R}=\\frac{\\mathrm{abc}}{4 \\Delta}=\\frac{\\mathrm{a}^3}{\\sqrt{3} \\mathrm{a}^2}=\\frac{\\mathrm{a}}{\\sqrt{3}}\\) and \\(r_1=\\frac{\\Delta}{s-a}=\\frac{\\sqrt{3} / 4 a^2}{a / 2}=\\frac{\\sqrt{3}}{2} a\\)\nHence, \\(\\mathrm{r}: \\mathrm{R}: \\mathrm{r}_1=\\frac{\\mathrm{a}}{2 \\sqrt{3}}: \\frac{\\mathrm{a}}{\\sqrt{3}}: \\frac{\\sqrt{3}}{2} \\mathrm{a}=1: 2: 3\\)",
            "image": null
          },
