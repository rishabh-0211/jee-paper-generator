          "question": {
            "text": "Let $A, B$ and $C$ are the angles of a triangle and $\\tan \\frac{A}{2}=\\frac{1}{3}, \\tan \\frac{B}{2}=\\frac{2}{3}$. Then, $\\tan \\frac{C}{2}$ is equal to",
            "image": null
          },
          "options": [
            {
              "id": "n6wQQ",
              "text": "$\\frac{7}{9}$",
              "image": null,
              "isCorrect": true
