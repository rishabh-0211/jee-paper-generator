              "isCorrect": false,
              "image": null
            },
            {
              "id": "zmazA",
              "text": "$-\\frac{1}{2} \\cos 2 \\theta$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "jTiHp",
              "text": "$\\frac{1}{2}$",
              "isCorrect": false,
              "image": null
            }
