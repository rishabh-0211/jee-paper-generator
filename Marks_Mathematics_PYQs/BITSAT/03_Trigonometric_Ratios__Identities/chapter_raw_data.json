          "type": "singleCorrect",
          "level": 2,
          "question": {
            "text": "The equation $\\sin ^{4} x-(k+2) \\sin ^{2} x-(k+3)=0$ possesses a solution if",
            "image": null
          },
          "options": [
            {
              "id": "rnF11",
              "text": "$k>-3$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "q5gBn",
              "text": "$k<-2$",
              "isCorrect": false,
