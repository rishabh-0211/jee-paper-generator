              "id": "2QjU6",
              "text": "<math><mn>12</mn></math> units",
              "image": null,
              "isCorrect": true
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/179792.png\" style=\"width: 147px; height: 159px;\" /><br /><br /><math><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mrow> <msup> <mrow> <mn>60</mn></mrow> <mi>o</mi> </msup> </mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mn>4</mn><mo>+</mo><mn>25</mn><mo>-</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2.2</mn><mo>.</mo><mn>5</mn></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><mn>10</mn><mo>=</mo><mn>29</mn><mo>-</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mo>⇒</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>19</mn></math><br /><br /><math><mo>⇒</mo><mi>c</mi><mo>=</mo><msqrt><mn>19</mn></msqrt></math><br /><br />Now,<br /><br /><math> <mrow> <mi>cos</mi><mn>120</mn><mi>°</mi><mo>=</mo><mfrac> <mrow> <msup> <mi>a</mi> <mn>2</mn> </msup> <mo>+</mo><msup> <mi>b</mi> <mn>2</mn> </msup> <mo>−</mo><msup> <mi>c</mi> <mn>2</mn> </msup> </mrow> <mrow> <mn>2</mn><mi>a</mi><mi>b</mi> </mrow> </mfrac> </mrow> </math><br /><br /><math> <mo>⇒</mo> </math> <math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>19</mn></mrow><mrow><mn>2</mn><mi>a</mi><mi>b</mi></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>19</mn><mo>=</mo><mo>-</mo><mi>a</mi><mi>b</mi></math><br /><br /><math><mo>⇒</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>a</mi><mi>b</mi><mo>=</mo><mn>19</mn></math><br /><br />Area of quadrilateral&nbsp;&nbsp;<math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>×</mo><mn>2</mn><mo>×</mo><mn>5</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>60°</mn></mrow></mrow><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>a</mi><mi>b</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>120°</mi></mrow></mrow><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></math><br /><br /><math><mo>⇒</mo><mfrac><mrow><mn>5</mn><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>a</mi><mi>b</mi><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>4</mn></mrow></mfrac><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></math><br /><br /><math><mo>⇒</mo><mfrac><mrow><mi>a</mi><mi>b</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>=</mo><mn>4</mn><mo>-</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><mi>a</mi><mi>b</mi><mo>=</mo><mn>6</mn></math><br /><br /><math><mo>⇒</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>13</mn></math><br /><br /><math><mo>⇒</mo><mi>a</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi>&nbsp;</mi><mi>b</mi><mo>=</mo><mn>3</mn></math><br /><br />Perimeter<br /><br /><math><mo>=</mo><mn>2</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn></math><br /><br /><math><mo>=</mo><mn>12</mn></math>",
