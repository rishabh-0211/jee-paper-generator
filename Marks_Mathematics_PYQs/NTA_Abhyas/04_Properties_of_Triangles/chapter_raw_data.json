          "question": {
            "text": "The lengths of two adjacent sides of a cyclic quadrilateral are <math><mn>2</mn></math> units and <math><mn>5</mn></math> units and the angle between them is <math><msup><mrow><mn>60</mn></mrow><mrow><mn>o</mn></mrow></msup></math>. If the area of the quadrilateral is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msqrt><mn>3</mn></msqrt></math>&nbsp;sq. units, then the perimeter of the quadrilateral is",
            "image": null
          },
          "options": [
            {
              "id": "AkBgE",
              "text": "<math><mn>12.5</mn></math> units",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "f6GTk",
              "text": "<math><mn>13</mn></math> units",
              "image": null,
              "isCorrect": false
