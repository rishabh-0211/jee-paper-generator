          "question": {
            "text": "The difference between the maximum values of ${ }^6 \\mathrm{C}_{\\mathrm{r}}$ and ${ }^n \\mathrm{C}_{\\mathrm{r}} 16$, then $\\mathrm{n}=$",
            "image": null
          },
          "options": [
            {
              "id": "Sa4NE",
              "text": "3",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "hnUmv",
