          },
          "options": [
            {
              "id": "jpfOg",
              "text": "$\\frac{2}{45}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "vQHmi",
              "text": "$\\frac{7}{45}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "ukhJr",
              "text": "$\\frac{4}{45}$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "xNxe1",
              "text": "$\\frac{1}{45}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$e^{2 x}=1+2 x+\\frac{(2 x)^{2}}{2 !}+\\frac{(2 x)^{3}}{3 !}+\\frac{(2 x)^{4}}{4 !}+\\frac{(2 x)^{6}}{6 !}+$\n$x^{6} \\rightarrow$ coefficient $=\\left(\\frac{2^{6} \\cdot x^{6}}{6 !}=\\frac{4}{45}\\right.$",
