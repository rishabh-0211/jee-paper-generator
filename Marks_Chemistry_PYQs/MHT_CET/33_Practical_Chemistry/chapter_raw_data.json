              "text": "$\\mathrm{Fe}^{2+}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "dd3gi",
              "text": "$\\mathrm{Cu}^{2+}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "sPxYp",
              "text": "$\\mathrm{Cu}^{+}$",
              "image": null,
              "isCorrect": true
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "\\begin{array}{|c|c|c|}\n\\hline Ion & \\begin{array}{c} \nOuter electronic \\\\\nconfiguration\n\\end{array} & \\begin{array}{c} \nNo. of unpaired \\\\\nelectrons\n\\end{array} \\\\\n\\hline \\mathrm{Fe}^{3+} & 3 \\mathrm{~d}^5 & 5 \\\\\n\\hline \\mathrm{Fe}^{2+} & 3 \\mathrm{~d}^6 & 4 \\\\\n\\hline \\mathrm{Cu}^{2+} & 3 \\mathrm{~d}^9 & 1 \\\\\n\\hline \\mathrm{Cu}^{+} & 3 \\mathrm{~d}^{10} & 0 \\\\\n\\hline\n\\end{array}\n$\\mathrm{Cu}^{+}$is colourless because of the absence of unpaired electrons.",
