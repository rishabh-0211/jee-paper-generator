              "isCorrect": false,
              "image": null
            },
            {
              "id": "ioPoK",
              "text": "$\\mathrm{HBO}_{2}$ and $\\mathrm{H}_{3} \\mathrm{BO}_{3}$",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
