              "text": "$\\mathrm{B}_{2} \\mathrm{O}_{3}$ and $\\mathrm{H}_{3} \\mathrm{BO}_{3}$",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "r1hKJ",
              "text": "$\\mathrm{B}_{2} \\mathrm{O}_{3}$ and $\\left[\\mathrm{BH}_{4}\\right]^{-}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "fK0Pg",
