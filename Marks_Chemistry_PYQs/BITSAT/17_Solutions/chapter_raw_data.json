          ],
          "question": {
            "text": "58.5 g of NaCl and 180 g of glucose were separately dissolved in 1000 mL of water. Identify the correct statement regarding the elevation of boiling point of the resulting solution.",
            "image": null
          },
          "options": [
            {
              "id": "dudhB",
              "text": "NaCl solution will show higher elevation of boiling point.",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "TOax5",
              "text": "Glucose solution will show higher elevation of boiling point.",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "8Eg7Y",
              "text": "Both the solution will show equal elevation of boiling point.",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "doFNh",
              "text": "None will show boiling point elevation.",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\begin{aligned}\n\\text {  } 58.5 \\mathrm{~g} \\mathrm{NaCl} & =\\frac{58.5}{58.5} \\mathrm{~mol} \\\\\n& =1 \\mathrm{~mol} \\\\\n180 \\mathrm{~g} \\text { of glucose } & =\\frac{180}{180}=1 \\mathrm{~mol}\n\\end{aligned}$\nThus, we have 1 M NaCl and 1 M glucose solution.\nBut NaCl dissociates in the solution and glucose does not dissociates.\nThus particle concentration is more in NaCl .\nHence, NaCl solution will have higher elevation in boiling point.",
            "image": null
          },
          "videoSolution": null,
          "syllabusCategory": "noChange",
