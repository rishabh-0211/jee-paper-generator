      "title": "Vapour pressure and raoult's law",
      "totalQuestions": 2,
      "questions": [
        {
          "_id": "64c0e8236f5bfc7ab78aeaea",
          "previousYearPapers": [
            {
              "_id": "64c0e679aef333185c6bb44c",
              "examId": "615d7713c52ffa3c944600e3",
              "heldOn": "2021-04-30T09:00:00.000Z",
              "isVisible": true,
              "shortName": "2021",
