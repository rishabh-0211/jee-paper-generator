          ],
          "question": {
            "text": "Coolant used in car radiator is aqueous solution of ethylene glycol. In order to prevent the solution from freezing at $-0.3^{\\circ} \\mathrm{C}$. How much ethylene glycol must be added to $5 \\mathrm{~kg}$ of water ? $\\left(\\mathrm{K}_{\\mathrm{f}}=1.86 \\mathrm{~K} \\mathrm{Kg} \\mathrm{mol}^{-1}\\right)$",
            "image": null
          },
          "options": [
            {
              "id": "3sULO",
              "text": "$50 \\mathrm{~g}$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "lbJoA",
              "text": "$55 \\mathrm{~g}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "KDrvR",
              "text": "$45 \\mathrm{~g}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "eBsLr",
              "text": "$40 \\mathrm{~g}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\Delta \\mathrm{T}_{\\mathrm{f}}=0.3^{\\circ} \\mathrm{C}$\n$$\n\\begin{array}{l}\n\\Delta \\mathrm{T}_{\\mathrm{f}}=\\frac{\\mathrm{K}_{\\mathrm{f}} \\times \\mathrm{W}_{\\mathrm{B}} \\times 1000}{\\mathrm{M}_{\\mathrm{B}} \\times \\mathrm{W}_{\\mathrm{A}}} \\\\\n0.3=\\frac{1.86 \\times \\mathrm{W}_{\\mathrm{B}} \\times 1000}{62 \\times 5000}\n\\end{array}\n$$\n$\\therefore \\mathrm{W}_{\\mathrm{B}}=50 \\mathrm{~g}$\nThe amount used should be more than $50 \\mathrm{~g}$.",
            "image": null
          },
