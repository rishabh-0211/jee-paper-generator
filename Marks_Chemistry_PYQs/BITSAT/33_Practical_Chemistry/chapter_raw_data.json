          ],
          "type": "singleCorrect",
          "level": 2,
          "question": {
            "text": "When $\\mathrm{C}_{2} \\mathrm{H}_{2}, \\mathrm{CH}_{4}$ and $\\mathrm{C}_{2} \\mathrm{H}_{4}$ pass through a test tube which has ammonical $\\mathrm{Cu}_{2} \\mathrm{Cl}_{2}$, find out which gas comes out unaffected from test tube?",
            "image": null
          },
          "options": [
            {
              "id": "oE184",
              "text": "$\\mathrm{C}_{2} \\mathrm{H}_{2}$ and $\\mathrm{CH}_{4}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "mtdvF",
              "text": "$\\mathrm{C}_{2} \\mathrm{H}_{2}$ and $\\mathrm{C}_{2} \\mathrm{H}_{4}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "hULU7",
              "text": "$\\mathrm{C}_{2} \\mathrm{H}_{4}$ and $\\mathrm{CH}_{4}$",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "WXxT4",
              "text": "$\\mathrm{C}_{2} \\mathrm{H}_{2}$",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\mathrm{C}_{2} \\mathrm{H}_{2}$ forms copper acetylide with ammonical $\\mathrm{Cu}_{2} \\mathrm{Cl}_{2}$\r\n\r\n$\\begin{array}{l}\r\n\r\n\\mathrm{Cu}_{2} \\mathrm{Cl}_{2}+2 \\mathrm{NH}_{4} \\mathrm{OH} \\rightarrow \\mathrm{Cu}_{2} \\mathrm{O}+\\mathrm{H}_{2} \\mathrm{O}+2 \\mathrm{NH}_{4} \\mathrm{Cl} \\\\\r\n\r\n\\mathrm{Cu}_{2} \\mathrm{O}+\\mathrm{C}_{2} \\mathrm{H}_{2} \\rightarrow \\underset{\\text { (copper acetylide) }}{\\mathrm{Cu}_{2} \\mathrm{C}_{2}}+\\mathrm{H}_{2} \\mathrm{O}\r\n\r\n\\end{array}$",
            "image": null
          },
          "videoSolution": null,
