          "type": "singleCorrect",
          "level": 2,
          "question": {
            "text": "Which of the following ions can be separated by aq. $\\mathrm{NH}_{4} \\mathrm{OH}$ in presence of $\\mathrm{NH}_{4} \\mathrm{Cl}$",
            "image": null
          },
          "options": [
            {
              "id": "YtTwo",
              "text": "$\\mathrm{Al}^{3+}$ and $\\mathrm{Fe}^{3+}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "Rc96r",
              "text": "$\\mathrm{Cr}^{3+}$ and $\\mathrm{Al}^{3+}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "B93ZM",
              "text": "$\\mathrm{Cu}^{2+}$ and $\\mathrm{Al}^{3+}$",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "TosPb",
              "text": "None of these",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\mathrm{Cu}^{2+}$ is of group II and $\\mathrm{Al}^{3+}$ is of group III of cation analysis.",
            "image": null
          },
          "videoSolution": null,
