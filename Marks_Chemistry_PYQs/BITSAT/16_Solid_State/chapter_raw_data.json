          ],
          "type": "singleCorrect",
          "level": 3,
          "question": {
            "text": "The non stoichiometric compound $\\mathrm{Fe}_{0.94} \\mathrm{O}$ is formed when $\\mathrm{x} \\%$ of $\\mathrm{Fe}^{2+}$ ions are replaced by as many $\\frac{2}{3} \\mathrm{Fe}^{3+}$ ions, $\\mathrm{x}$ is",
            "image": null
          },
          "options": [
            {
              "id": "zFNkV",
              "text": "18",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "Xp0tb",
              "text": "12",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "v6oW0",
              "text": "15",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "cytD8",
              "text": "6",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "The number of $\\mathrm{Fe}^{3+}$ ions replacing $\\mathrm{x} \\mathrm{Fe}^{2+}$ ions $=\\frac{2 \\mathrm{x}}{3}$ vacancies of cations\r\n\r\n$$\r\n\r\n\\begin{array}{l}\r\n\r\n=x-\\frac{2 x}{3}=x / 3 \\\\\r\n\r\n\\text { But } x / 3=1-0.94=0.06, x=0.06 \\times 3 \\\\\r\n\r\n=0.18=18 \\%\r\n\r\n\\end{array}\r\n\r\n$$",
            "image": null
          },
