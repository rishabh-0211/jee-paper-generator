            {
              "id": "Ot0qr",
              "text": "$\\mathrm{~K}_{p}=\\frac{2 \\mathrm{P}}{3}$",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/FF1dZ-oqNNSNDytMXuA1tI9bURJwNDZa08chwNZLWZg.original.fullsize.png\"><br>\r\n\r\n$\\mathrm{K}_{\\mathrm{p}}=\\frac{\\frac{\\mathrm{P}}{3} \\times \\frac{\\mathrm{P}}{3}}{\\frac{\\mathrm{P}}{3}}=\\frac{\\mathrm{P}}{3}$",
            "image": null
