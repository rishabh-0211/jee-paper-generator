              "isCorrect": false,
              "image": null
            },
            {
              "id": "JThDn",
              "text": "$\\mathrm{P}=3 \\mathrm{~K}_{p}$",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "E1s6R",
              "text": "$\\mathrm{P}=\\frac{2 K_{\\mathrm{P}}}{3}$",
              "isCorrect": false,
