            }
          ],
          "question": {
            "text": "The ratio $\\frac{K_P}{K_C}$ for the reaction\n$\\mathrm{CO}_{(\\mathrm{g})}+\\frac{1}{2} \\mathrm{O}_{2(\\mathrm{~g})} \\rightleftharpoons \\mathrm{CO}_{2(\\mathrm{~g})}$ is:",
            "image": null
          },
          "options": [
            {
              "id": "065cT",
              "text": "$(\\mathrm{RT})^{1 / 2}$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "4bo8L",
              "text": "$RT$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "jrEvj",
              "text": "$1$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "E6L9o",
              "text": "$\\frac{1}{\\sqrt{\\mathrm{RT}}}$",
              "image": null,
              "isCorrect": true
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\mathrm{CO}(\\mathrm{g})+\\frac{1}{2} \\mathrm{O}_2(\\mathrm{~g}) \\rightleftharpoons \\mathrm{CO}_2(\\mathrm{~g})$\n$\\mathrm{K}_{\\mathrm{P}}$ and $\\mathrm{K}_{\\mathrm{C}}$ are related as\n$\\mathrm{K}_{\\mathrm{P}}=\\mathrm{K}_{\\mathrm{C}}(\\mathrm{RT})^{\\Delta \\mathrm{n}_{\\mathrm{g}}}$\n$\\Rightarrow \\quad \\Delta \\mathrm{n}_{\\mathrm{g}}=\\mathrm{n}_{\\mathrm{P}}-\\mathrm{n}_{\\mathrm{R}}=1-1 \\frac{1}{2}=-\\frac{1}{2}$\n$\\Delta \\mathrm{n}_{\\mathrm{g}}$ for the given reaction $=-\\frac{1}{2}$\n$\\therefore \\frac{\\mathrm{K}_{\\mathrm{P}}}{\\mathrm{K}_{\\mathrm{C}}}=\\frac{1}{\\sqrt{\\mathrm{RT}}}$",
            "image": null
          },
          "videoSolution": null,
          "syllabusCategory": "noChange",
          "questionStructure": [
            "default"
          ],
          "previousYear": {
            "_id": "67726ce6d221dc77889e6414",
            "examId": "615d7713c52ffa3c944600e3",
            "heldOn": "2024-04-15T09:00:00.000Z",
            "isVisible": true,
            "shortName": "2024 (Memory Based Paper 1)",
            "title": "BITSAT 2024 (Memory Based Paper 1)"
          },
          "evalStatus": "notAttempted",
          "lastPracticed": null
        },
        {
          "_id": "64c0e8326f5bfc7ab78aeb6c",
          "previousYearPapers": [
            {
              "_id": "64c0e679aef333185c6bb44d",
