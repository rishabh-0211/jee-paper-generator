            {
              "id": "vtwDB",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>064</mn><mo>&#160;</mo><mi>atm</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>095</mn><mo>&#160;</mo><mi>atm</mi></math>",
