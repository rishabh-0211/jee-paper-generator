            {
              "id": "ohHJu",
              "text": "The temperature will increase.",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "94azk",
              "text": "The temperature will decrease.",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Byaddition of $\\mathrm{SO}_{2}$, equilibrium will shift to RHS which is exothermic. Hence temp, will increase.",
            "image": null
