          "type": "singleCorrect",
          "level": 2,
          "question": {
            "text": "<p>Which of the following lanthanoid is diamagnetic?</p><p>Atomic no&#39;s&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Sm</mi><mo>=</mo><mn>62</mn><mo>,</mo><mo>&#160;</mo><mi>Ce</mi><mo>=</mo><mn>58</mn><mo>,</mo><mo>&#160;</mo><mi>Eu</mi><mo>=</mo><mn>63</mn><mo>,</mo><mo>&#160;</mo><mi>Yb</mi><mo>=</mo><mn>70</mn></math></p>",
            "image": null
          },
          "options": [
            {
              "id": "WDUQO",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Sm</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
              "isCorrect": false,
