          "options": [
            {
              "id": "DIojG",
              "text": "hydrogen has little affinity to $\\mathrm{O}_{2}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "gZe3R",
              "text": "hydrogen has more affinity to $\\mathrm{O}_{2}$",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "gHbhH",
              "text": "hydrogen has more affinity to chlorine",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "zkfJJ",
              "text": "it is a reducing agent",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\mathrm{Cl}_{2}+\\mathrm{H}_{2} \\mathrm{O} \\rightarrow 2 \\mathrm{HCl}+\\frac{1}{2} \\mathrm{O}_{2}$\r\nHydrogen has more affinity for chlorine.",
            "image": null
          },
