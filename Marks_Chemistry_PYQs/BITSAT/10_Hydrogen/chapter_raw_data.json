            {
              "id": "a5fjP",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mfenced><mi mathvariant=\"normal\">s</mi></mfenced><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi><mfenced><mi mathvariant=\"normal\">g</mi></mfenced><mover><mo>&#10230;</mo><mrow><mn>1270</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></mrow></mover><mi>CO</mi><mfenced><mi>g</mi></mfenced><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">g</mi></mfenced></math>",
