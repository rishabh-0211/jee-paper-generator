          "options": [
            {
              "id": "eTheP",
              "text": "\r\n$3 s, 3 p$ and $3 d$-orbitals all have the same energy.\r\n",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "wqDqH",
              "text": "\r\n$3 s$ and $3 p$-orbitals are of lower energy than $3 d$-orbital.\r\n",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "i3NRI",
              "text": "\r\n$3 p$-orbital is lower in energy than $3 d$-orbital.\r\n",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "j2Dps",
              "text": "\r\n$3 s$-orbital is lower in energy than $3 p$-orbital.",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "The hydrogen atom has the configuration $1 s$ and $3 s, 3 p$ and $3 d$-orbitals will have same energy with respect to $1 s$-orbital.",
            "image": null
          },
