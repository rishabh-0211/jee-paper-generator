            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<p>Using&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>PM</mi><mo>=</mo><mi>dRT</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi mathvariant=\"normal\">P</mi><mn>1</mn></msub><mi mathvariant=\"normal\">M</mi></mrow><mrow><msub><mi mathvariant=\"normal\">P</mi><mn>2</mn></msub><mi mathvariant=\"normal\">M</mi></mrow></mfrac><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mfrac><mrow><msub><mi mathvariant=\"normal\">d</mi><mn>1</mn></msub><msub><mi>RT</mi><mn>1</mn></msub></mrow><mrow><msub><mi mathvariant=\"normal\">d</mi><mn>2</mn></msub><msub><mi>RT</mi><mn>2</mn></msub></mrow></mfrac><mspace linebreak=\"newline\"/><mfrac><mn>768</mn><mn>760</mn></mfrac><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mfrac><mrow><mn>1</mn><mo>.</mo><mn>35</mn><mo>&#215;</mo><mn>303</mn></mrow><mrow><msub><mi mathvariant=\"normal\">d</mi><mn>2</mn></msub><mo>&#215;</mo><mn>273</mn></mrow></mfrac><mspace linebreak=\"newline\"/><msub><mi mathvariant=\"normal\">d</mi><mn>2</mn></msub><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mfrac><mrow><mn>1</mn><mo>.</mo><mn>35</mn><mo>&#215;</mo><mn>303</mn><mo>&#215;</mo><mn>760</mn></mrow><mrow><mn>273</mn><mo>&#215;</mo><mn>768</mn></mrow></mfrac><mspace linebreak=\"newline\"/><msub><mi mathvariant=\"normal\">d</mi><mn>2</mn></msub><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mn>1</mn><mo>.</mo><mn>48</mn><mo>&#160;</mo><mi>kg</mi><mo>/</mo><msup><mi mathvariant=\"normal\">m</mi><mn>3</mn></msup><mspace linebreak=\"newline\"/></math></p>",
