      "totalQuestions": 3,
      "questions": [
        {
          "_id": "65b7b87d97ae24e9e2db8cda",
          "type": "singleCorrect",
          "level": 1,
          "questionLabels": [],
          "previousYearPapers": [
            {
              "_id": "65b7b85fb3be70ed63adbe85",
              "examId": "615d7713c52ffa3c944600e3",
              "heldOn": "2023-04-15T14:00:00.000Z",
              "isVisible": true,
              "shortName": "2023 (Memory Based Paper 2)",
              "title": "BITSAT 2023 (Memory Based Paper 2)"
            }
          ],
          "question": {
            "text": "In van der Waal's equation of state for a nonideal gas, the term that accounts for intermolecular forces is",
            "image": null
          },
          "options": [
            {
              "id": "maq76",
              "text": "$(V-b)$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "ZbYry",
              "text": "$R T$",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "GpdVO",
              "text": "$\\left(P+\\frac{a}{V^2}\\right)$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "9LKWC",
              "text": "$(R T)^{-1}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\left(P+\\frac{a}{V^2}\\right)(V-b)=R T$; Here $\\left(P+\\frac{a}{V^2}\\right)$ represents the intermolecular forces.",
            "image": null
          },
          "videoSolution": null,
          "syllabusCategory": "noChange",
          "questionStructure": [
            "default"
          ],
          "previousYear": {
            "_id": "65b7b85fb3be70ed63adbe85",
            "examId": "615d7713c52ffa3c944600e3",
