            "examId": "615d7713c52ffa3c944600e3",
            "heldOn": "2022-04-30T09:00:00.000Z",
            "isVisible": true,
            "shortName": "2022",
            "title": "BITSAT 2022"
          },
          "evalStatus": "notAttempted",
          "lastPracticed": null
        },
