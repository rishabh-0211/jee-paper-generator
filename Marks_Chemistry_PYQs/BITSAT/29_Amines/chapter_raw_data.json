              "isVisible": true,
              "shortName": "2017",
              "title": "BITSAT 2017"
            }
          ],
          "type": "singleCorrect",
          "level": 1,
          "question": {
            "text": "<p>In the reaction,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>&#183;</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>&#183;</mo><mi>Cl</mi><mover><mo>&#10230;</mo><mi>KCN</mi></mover><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mover><mo>&#10230;</mo><msub><mi>LiAlH</mi><mn>4</mn></msub></mover><mfenced><mi mathvariant=\"normal\">P</mi></mfenced></math> end product <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">P</mi></mfenced></math> is</p>",
            "image": null
          },
          "options": [
            {
              "id": "F3Uyu",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#183;</mo><msub><mi>NO</mi><mn>2</mn></msub></math>",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "mkgs7",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>NO</mi><mn>2</mn></msub></math>",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "S1Fuv",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math>",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "YJrik",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>&#183;</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>&#183;</mo><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math>",
              "isCorrect": true,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "<p>When the reducing agent is lithium aluminium hydride, the aldehyde group is reduced to primary alcohol but the carbon-carbon double bond is unaffected.</p><p>In the given reaction the end product is (d). It is obtained<br />as follows.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#183;</mo><mi>Cl</mi><mover><mo>&#10230;</mo><mi>KCN</mi></mover><munder><mrow><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>CN</mi></mrow><mrow><mo>(</mo><mi mathvariant=\"normal\">A</mi><mo>)</mo></mrow></munder><munderover><mo>&#8594;</mo><mrow><mo>(</mo><mi>Reduction</mi><mo>)</mo></mrow><msub><mi>LiAlH</mi><mn>4</mn></msub></munderover><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#183;</mo><msub><mi>NH</mi><mn>2</mn></msub></math></p>",
            "image": null
          },
          "videoSolution": null,
          "questionLabels": [],
