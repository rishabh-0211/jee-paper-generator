              "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/egGBdcTy0UDKIAnCZwYInqqERryoN2iU0wIWKOYXxMw.original.fullsize.png\"/><br/>",
              "image": null,
              "isCorrect": false
            },
            {
              "id": "MMhEK",
              "text": "$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{Br}$",
              "image": null,
              "isCorrect": true
            },
            {
              "id": "sC7iE",
              "text": "$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{CH}_2 \\mathrm{Br}$",
              "image": null,
              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "The rate of $S_n 2$ reaction is the maximum with $1^{\\circ}$ allyl halide having least steric hindrance. Out of\n$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{Br}$ and $\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{CH}_2 \\mathrm{Br}, \\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{Br}$ has the least steric hindrance and hence has the highest relative rate.",
            "image": null
          },
