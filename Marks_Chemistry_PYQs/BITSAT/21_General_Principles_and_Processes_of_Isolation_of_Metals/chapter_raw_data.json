            {
              "id": "EX6NX",
              "text": "zone refining",
              "isCorrect": true,
              "image": null
            },
            {
              "id": "ejQvP",
              "text": "liquation",
              "isCorrect": false,
              "image": null
            },
            {
              "id": "pgSDX",
              "text": "electrolytic refining",
              "isCorrect": false,
              "image": null
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "Semiconductor materials like Si and Ge are usually purified by zone refining. Zone refining is based on the principle of fractional crystallisation i.e. difference in\r\n\r\nstates of metal, so that the zones of impurities are formed and finally removed.",
            "image": null
          },
          "videoSolution": null,
