              "isCorrect": false
            }
          ],
          "correctValue": null,
          "solution": {
            "text": "$\\mathrm{N}_2(\\mathrm{~g})+\\mathrm{O}_2(\\mathrm{~g}) \\rightarrow 2 \\mathrm{NO}(\\mathrm{g})$\n$2 \\mathrm{NO}(\\mathrm{g})+\\mathrm{O}_2(\\mathrm{~g}) \\rightarrow 2 \\mathrm{NO}_2(\\mathrm{~g})$\nHigher concentration of $\\mathrm{NO}_2$ damage the leaves and retard the rate of photosynthesis.",
