            },
            {
              "id": "sQC9w",
              "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8710;</mo><mi mathvariant=\"normal\">H</mi></math> is independent of the catalyst, if any.",
              "isCorrect": true,
